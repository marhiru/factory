{
  "manifest_version": 3,
  "name": "vf studio — métricas do YouTube Studio",
  "version": "0.1.0",
  "description": "Captura as métricas que o próprio YouTube Studio carrega (ex.: Continuaram assistindo) e entrega ao vf, sem tirar cookies do navegador.",
  "key": "",
  "permissions": ["storage", "alarms", "nativeMessaging", "tabs"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://studio.youtube.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://studio.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "vf studio" }
}
